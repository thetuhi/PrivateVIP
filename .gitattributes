# Normalise line endings so the repo stays consistent regardless of which OS a
# contributor is on. Without this, a Windows checkout commits CRLF and every
# later diff on a Mac or Linux machine shows the whole file as changed.
* text=auto eol=lf

# Binary assets: never touched, never diffed as text.
*.webp binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# Generated, so keep it out of diff noise and language statistics.
src/styles/fonts.css linguist-generated=true
package-lock.json linguist-generated=true
